{
  "expo": {
    "name": "Un paso a la vez",
    "slug": "reflexion-diaria",
    "version": "1.0.0",
    "scheme": "reflexiondiaria",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.erickleal.reflexiondiaria"
    },
    "android": {
      "package": "com.erickleal.reflexiondiaria",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F8F6",
          "dark": { "backgroundColor": "#0F1513" }
        }
      ]
    ],
    "extra": {
      "router": {}
    }
  }
}
