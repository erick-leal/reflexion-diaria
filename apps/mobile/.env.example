# URL del backend (publica, no es secreto: queda inline en el bundle).
# Produccion: https://reflexion-diaria-production.up.railway.app
# Backend local desde el telefono: http://<IP-de-tu-PC-en-la-LAN>:8000
# En EAS Build esta variable NO se lee de .env: debe ir en el bloque "env"
# de cada perfil de eas.json (gotcha heredado de Versiculo Diario).
EXPO_PUBLIC_API_URL=https://reflexion-diaria-production.up.railway.app
